diff --git a/harness/sandbox.py b/harness/sandbox.py
new file mode 100644
index 0000000..4257b40
--- /dev/null
+++ b/harness/sandbox.py
@@ -0,0 +1,151 @@
+"""
+Sandboxed evaluation of a model-written `lambda x, y, z: ...` final guess (witness eval patch).
+
+Upstream `LLMReasoningHarness._handle_final_guess` did `guessed_lambda = eval(guess_str)` in-process with full
+builtins and then called it ~79k times. Here the guess is (1) AST-checked (single lambda; no dunder names or
+attributes; no await/yield), (2) evaluated in a CHILD PROCESS with a whitelisted `__builtins__` + `math`,
+CPU/memory/file rlimits and a wall-clock timeout, optionally under an unprivileged uid, and (3) compared with the
+hidden rule on the SAME input distribution as upstream `_generate_test_inputs` (transcribed verbatim below; the
+only deliberate change is a fixed random seed so a verdict is reproducible).
+
+Parent API:  check_guess(guess_str, rule, tuple_length) -> {"ok": bool, "all_correct": bool, "error": str, ...}
+Child:       python -m harness.sandbox --child   (reads one JSON object on stdin, writes one on stdout)
+Environment: WILT_SANDBOX_USER   drop to this uid/gid via `setpriv` when running as root and setpriv exists
+             WILT_SANDBOX_TIMEOUT seconds (default 120)   WILT_SANDBOX_MEM_MB (default 2048)  WILT_SANDBOX_CPU_S (60)
+"""
+import ast
+import inspect
+import itertools
+import json
+import math
+import os
+import random
+import shutil
+import subprocess
+import sys
+
+REPO_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+
+SAFE_BUILTINS = {
+    "abs": abs, "all": all, "any": any, "bool": bool, "divmod": divmod, "enumerate": enumerate, "filter": filter,
+    "float": float, "int": int, "isinstance": isinstance, "len": len, "list": list, "map": map, "max": max,
+    "min": min, "pow": pow, "range": range, "round": round, "set": set, "sorted": sorted, "str": str, "sum": sum,
+    "tuple": tuple, "zip": zip, "reversed": reversed, "True": True, "False": False, "None": None,
+}
+
+
+def validate_guess_ast(guess_str):
+    tree = ast.parse(guess_str, mode="eval")
+    if not isinstance(tree.body, ast.Lambda):
+        raise ValueError("final guess must be a single lambda expression")
+    for node in ast.walk(tree):
+        if isinstance(node, ast.Attribute) and node.attr.startswith("__"):
+            raise ValueError("dunder attribute access is not allowed: %s" % node.attr)
+        if isinstance(node, ast.Name) and node.id.startswith("__"):
+            raise ValueError("dunder name is not allowed: %s" % node.id)
+        if isinstance(node, (ast.Await, ast.Yield, ast.YieldFrom)):
+            raise ValueError("await/yield not allowed")
+    return tree
+
+
+def _generate_test_inputs(tuple_length):
+    # Transcribed verbatim from LLMReasoningHarness._generate_test_inputs (same counts, ranges, special cases).
+    random_inputs_1 = [tuple(random.uniform(-200, 200) for _ in range(tuple_length)) for _ in range(5000)]
+    random_inputs_2 = [tuple(random.uniform(-3, 3) for _ in range(tuple_length)) for _ in range(5000)]
+    grid_inputs = list(itertools.product(range(-20, 21), repeat=tuple_length))
+    special_tests = [
+        (0.1, 0.2, 0.3),
+        (1.1, 1.2, 1.3),
+        (2.5, 2.6, 2.7),
+        (0.1, 0.2, 0.3),
+        (0.3, 0.6, 0.9),
+        (0.1234, 0.5678, 0.9123),
+        (0, 0.5, 1),
+        (1, 1.5, 2),
+        (2.5, 3, 3.5),
+        (3.9, 4.2, 4.8)
+    ] # likely removable with multi resolution random
+    return random_inputs_1 + random_inputs_2 + grid_inputs + special_tests
+
+
+def _find_rule_by_lineno(lineno):
+    from harness import test_cases as tc
+    for dname in ("TESTS_FULL", "TESTS_LITE", "TESTS_BAYESIAN", "TESTS_BAYESIAN_SINGLE"):
+        for fn in getattr(tc, dname).values():
+            if getattr(getattr(fn, "__code__", None), "co_firstlineno", None) == lineno:
+                return fn
+    raise KeyError("no hidden rule defined at harness/test_cases.py line %d" % lineno)
+
+
+def _set_rlimits():
+    try:
+        import resource
+    except ImportError:
+        return
+    mem = int(os.environ.get("WILT_SANDBOX_MEM_MB", "2048")) * 1024 * 1024
+    cpu = int(os.environ.get("WILT_SANDBOX_CPU_S", "60"))
+    for res, val in ((getattr(resource, "RLIMIT_AS", None), (mem, mem)),
+                     (getattr(resource, "RLIMIT_CPU", None), (cpu, cpu)),
+                     (getattr(resource, "RLIMIT_FSIZE", None), (1 << 20, 1 << 20)),
+                     (getattr(resource, "RLIMIT_NOFILE", None), (32, 32))):
+        if res is None:
+            continue
+        try:
+            resource.setrlimit(res, val)
+        except (ValueError, OSError):
+            pass
+
+
+def _child_main():
+    req = json.loads(sys.stdin.read())
+    _set_rlimits()
+    try:
+        tree = validate_guess_ast(req["guess"])
+        guessed_lambda = eval(compile(tree, "<final_guess>", "eval"), {"__builtins__": dict(SAFE_BUILTINS), "math": math}, {})
+        if not callable(guessed_lambda):
+            raise ValueError("guess did not evaluate to a callable")
+        rule = _find_rule_by_lineno(int(req["rule_lineno"]))
+        random.seed(int(req.get("seed", 12345)))
+        test_inputs = _generate_test_inputs(int(req["tuple_length"]))
+        all_correct = all(rule(*inputs) == guessed_lambda(*inputs) for inputs in test_inputs)
+        out = {"ok": True, "all_correct": bool(all_correct), "n_inputs": len(test_inputs)}
+    except BaseException as e:  # includes RecursionError / MemoryError raised inside the guess
+        out = {"ok": False, "all_correct": False, "error": "%s: %s" % (type(e).__name__, str(e)[:300])}
+    sys.stdout.write(json.dumps(out))
+    sys.stdout.flush()
+
+
+def check_guess(guess_str, rule, tuple_length, timeout=None):
+    timeout = float(timeout or os.environ.get("WILT_SANDBOX_TIMEOUT", "120"))
+    lineno = rule.__code__.co_firstlineno
+    cmd = [sys.executable, "-m", "harness.sandbox", "--child"]
+    user = os.environ.get("WILT_SANDBOX_USER")
+    if user and hasattr(os, "geteuid") and os.geteuid() == 0 and shutil.which("setpriv"):
+        import pwd
+        pw = pwd.getpwnam(user)
+        cmd = ["setpriv", "--reuid=%d" % pw.pw_uid, "--regid=%d" % pw.pw_gid, "--clear-groups"] + cmd
+    env = {"PYTHONPATH": REPO_ROOT, "PATH": os.environ.get("PATH", "/usr/bin:/bin"), "HOME": "/tmp",
+           "PYTHONDONTWRITEBYTECODE": "1", "PYTHONHASHSEED": "0"}
+    for k in ("WILT_SANDBOX_MEM_MB", "WILT_SANDBOX_CPU_S"):
+        if k in os.environ:
+            env[k] = os.environ[k]
+    payload = json.dumps({"guess": guess_str, "rule_lineno": lineno, "tuple_length": tuple_length, "seed": 12345})
+    try:
+        p = subprocess.run(cmd, input=payload, capture_output=True, text=True, timeout=timeout, env=env, cwd=REPO_ROOT)
+    except subprocess.TimeoutExpired:
+        return {"ok": False, "all_correct": False, "error": "sandbox timeout after %.0fs" % timeout}
+    if p.returncode != 0 or not p.stdout.strip():
+        return {"ok": False, "all_correct": False, "error": "sandbox exited rc=%d: %s" % (p.returncode, (p.stderr or "")[-300:])}
+    try:
+        res = json.loads(p.stdout.strip().splitlines()[-1])
+    except Exception as e:
+        return {"ok": False, "all_correct": False, "error": "sandbox output unparseable: %s" % e}
+    res["rule_src"] = inspect.getsource(rule).strip()
+    return res
+
+
+if __name__ == "__main__":
+    if "--child" in sys.argv:
+        _child_main()
+    else:
+        print(__doc__)
