index 0000000..a2510f9
--- /dev/null
+++ b/models/sglang_model.py
@@ -0,0 +1,105 @@
+from .base_model import BaseModel, EndpointFailure
+import json
+import os
+import random
+import sys
+import threading
+import time
+import openai
+
+"""
+SGLang / OpenAI-compatible model (witness eval patch). Select with  --model sglang/<served-model-name>.
+
+Environment:
+  SGLANG_BASE_URL   required, e.g. http://127.0.0.1:30001/v1
+  SGLANG_API_KEY    optional (default "x"; SGLang ignores it)
+  WILT_MAX_TOKENS   default 4096. Sent explicitly on every call: the upstream OpenAI/OpenRouter model files send no
+                    max_tokens, and SGLang's fallback when the client omits it is NOT "unlimited".
+  WILT_TEMPERATURE  optional. If unset, NO temperature/top_p is sent and the server's --sampling-defaults apply
+                    (openai => temperature 1.0 / top_p 1.0 / top_k off), matching the DiG-bench campaign.
+  WILT_CALL_LOG     optional JSONL path; one line per call (finish_reason, matched_stop, usage, reasoning length).
+                    Exhausted retries are logged too, as {"error": ..., "attempts": 6, ...}.
+  WILT_HTTP_TIMEOUT per-request HTTP timeout in seconds (default 1800; SDK default 600 is too short for 32k thinking).
+Thinking on/off is a SERVER-side switch (--default-chat-template-kwargs); this client sends no extra_body.
+Failure contract: after 6 back-off retries (~1 min incl. the SDK's own 2 retries per 5xx) perform_step RAISES EndpointFailure (models/base_model.py). The
+upstream OpenAIModel returned "" instead, which the harness cannot tell apart from a model that answered nothing:
+two such "" in a row end the episode with 0 points and the results JSON still looks complete, so a server restart
+on one arm's GPU would silently depress that arm only. The harness catches EndpointFailure and flags the episode
+(`infra_errors`), the launcher marks the rep INFRA_TAINTED and re-runs it, the summarizer never scores it.
+"""
+
+
+class SglangModel(BaseModel):
+    def __init__(self, model_name):
+        super().__init__(model_name)
+        base_url = os.environ.get("SGLANG_BASE_URL")
+        if not base_url:
+            raise RuntimeError("SGLANG_BASE_URL is not set (e.g. http://127.0.0.1:30001/v1)")
+        # WILT_HTTP_TIMEOUT: the SDK default (600 s) is too short for a 32k-token thinking turn on a loaded server.
+        self.client = openai.OpenAI(api_key=os.environ.get("SGLANG_API_KEY", "x"), base_url=base_url,
+                                    timeout=float(os.environ.get("WILT_HTTP_TIMEOUT", "1800")))
+        self.max_tokens = int(os.environ.get("WILT_MAX_TOKENS", "4096"))
+        t = os.environ.get("WILT_TEMPERATURE")
+        self.temperature = float(t) if t not in (None, "") else None
+        self.call_log = os.environ.get("WILT_CALL_LOG") or None
+        self._log_lock = threading.Lock()   # one model instance is shared by --multi threads
+
+    def perform_step(self, conversation_history):
+        kw = {"model": self.model_name, "messages": conversation_history, "max_tokens": self.max_tokens}
+        if self.temperature is not None:
+            kw["temperature"] = self.temperature
+        last_err = None
+        for attempt in range(6):
+            try:
+                response = self.client.chat.completions.create(**kw)
+                self._log(response, kw, attempt)
+                return response.choices[0].message.content or ""
+            except Exception as e:
+                last_err = e
+                time.sleep(min(2 ** attempt + random.random(), 20.0))
+        print(f"Error in SglangModel after retries: {last_err}", file=sys.stderr)
+        self._write({"ts": time.time(), "model": kw["model"], "n_messages": len(kw["messages"]), "max_tokens": kw["max_tokens"],
+                     "attempts": 6, "error": f"{type(last_err).__name__}: {str(last_err)[:300]}"})
+        raise EndpointFailure(f"{type(last_err).__name__}: {str(last_err)[:200]}")
+
+    def _write(self, rec):
+        if not self.call_log:
+            return
+        try:
+            with self._log_lock, open(self.call_log, "a", encoding="utf-8") as f:
+                f.write(json.dumps(rec) + "\n")
+        except Exception:
+            pass
+
+    def _log(self, response, kw, attempt):
+        if not self.call_log:
+            return
+        try:
+            ch = response.choices[0]
+            msg = ch.message
+            extra = getattr(msg, "model_extra", None) or {}
+            reasoning = getattr(msg, "reasoning_content", None) or extra.get("reasoning_content")
+            usage = getattr(response, "usage", None)
+            details = getattr(usage, "completion_tokens_details", None) if usage is not None else None
+            # SGLang extension: matched_stop is a str when a stop STRING cut the generation, an int (token id) for EOS.
+            matched_stop = getattr(ch, "matched_stop", None)
+            if matched_stop is None:
+                matched_stop = (getattr(ch, "model_extra", None) or {}).get("matched_stop")
+            rec = {
+                "ts": time.time(), "model": kw["model"], "served_model": getattr(response, "model", None),
+                "n_messages": len(kw["messages"]), "max_tokens": kw["max_tokens"], "temperature": kw.get("temperature"),
+                "attempt": attempt, "finish_reason": getattr(ch, "finish_reason", None), "matched_stop": matched_stop,
+                "prompt_tokens": getattr(usage, "prompt_tokens", None) if usage is not None else None,
+                "completion_tokens": getattr(usage, "completion_tokens", None) if usage is not None else None,
+                "reasoning_tokens": getattr(details, "reasoning_tokens", None) if details is not None else None,
+                "content_chars": len(msg.content or ""),
+                "reasoning_chars": len(reasoning) if isinstance(reasoning, str) else None,
+            }
+            self._write(rec)
+        except Exception:
+            pass
+
+    def initialize_conversation(self, system_prompt):
+        # SGLang's Qwen3.8 chat template rejects a message list without a user turn (HTTP 400 "No user query found in
+        # messages."), so the system prompt is followed by the minimal opener the upstream Anthropic adapter uses.
+        return [{"role": "system", "content": system_prompt}, {"role": "user", "content": "Please begin."}]
