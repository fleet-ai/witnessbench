index 00000000..c861d043
--- /dev/null
+++ b/wason_experiments/src/models/openai_compat_judge.py
@@ -0,0 +1,149 @@
+"""
+OpenAI-compatible JUDGE wrapper (witness eval patch).
+
+Same call surface as Llama33_70B / Qwen25Coder32B (`generate(prompt_or_messages, GenParams) -> str`,
+`describe_params()`), but talks to an HTTP endpoint (SGLang / vLLM OpenAI server, or OpenRouter) instead of an
+in-process vLLM engine. Selected by run_judge_guess.py / run_judge_compatibility.py when --model-path starts
+with http:// or https://.
+
+--model-path spec:  <base_url>#<model_name>
+    e.g.  http://127.0.0.1:30100/v1#llama-3.3-70b-instruct
+          https://openrouter.ai/api/v1#meta-llama/llama-3.3-70b-instruct
+Environment:
+    F2F_JUDGE_API_KEY        bearer key (default "x"; SGLang ignores it)
+    F2F_JUDGE_API_KEY_FILE   read the key from a file instead (e.g. /root/.openrouter_key); never printed
+    F2F_JUDGE_PROVIDER       optional JSON for OpenRouter provider pinning, e.g.
+                             '{"order":["Crusoe"],"allow_fallbacks":false}'
+    F2F_JUDGE_CALL_LOG       optional JSONL path: one line per call (finish_reason, usage)
+The judge endpoint MUST be a different process/server from the evaluated model.
+"""
+
+from dataclasses import dataclass
+from typing import Dict, Any, List, Union, Optional
+import json
+import os
+import random
+import time
+
+from openai import OpenAI, APIError, RateLimitError
+
+
+@dataclass
+class GenParams:
+    # Identical field set to models/llama33_70b.GenParams so the judge scripts can build it unchanged.
+    temperature: float = 0.6
+    top_p: float = 0.95
+    top_k: int = 20
+    max_new_tokens: int = 256
+    repetition_penalty: float = 1.0
+    stop: Optional[List[str]] = None
+
+
+class OpenAICompatJudge:
+    def __init__(self, spec: str):
+        if "#" not in spec:
+            raise ValueError("judge spec must be <base_url>#<model_name>, got: %r" % spec)
+        base_url, model = spec.rsplit("#", 1)
+        self.base_url = base_url.rstrip("/")
+        self.model_name = model
+        self.model_path = spec
+        key = os.getenv("F2F_JUDGE_API_KEY") or "x"
+        key_file = os.getenv("F2F_JUDGE_API_KEY_FILE")
+        if key_file:
+            with open(key_file, "r", encoding="utf-8") as f:
+                key = f.read().strip()
+        self.client = OpenAI(api_key=key, base_url=self.base_url)
+        prov = os.getenv("F2F_JUDGE_PROVIDER")
+        self.provider = json.loads(prov) if prov else None
+        self._call_log = os.getenv("F2F_JUDGE_CALL_LOG") or None
+        self.supports_think = False
+        # describe_params() parity with the local wrappers
+        self._defaults: Dict[str, Any] = {
+            "temperature": 0.0, "top_p": 0.95, "top_k": 50, "max_new_tokens": 12,
+            "repetition_penalty": 1.0, "stop": None,
+        }
+
+    def _messages(self, prompt: Union[str, List[Dict[str, str]]]) -> List[Dict[str, str]]:
+        if isinstance(prompt, list):
+            return prompt
+        return [{"role": "user", "content": str(prompt)}]
+
+    def generate(self, prompt: Union[str, List[Dict[str, str]]], params: Optional[GenParams] = None) -> str:
+        p = params or GenParams()
+        kw: Dict[str, Any] = {
+            "model": self.model_name,
+            "messages": self._messages(prompt),
+            "temperature": float(p.temperature),
+            "top_p": float(p.top_p),
+            "max_tokens": int(p.max_new_tokens),
+        }
+        if p.stop:
+            kw["stop"] = list(p.stop)[:4]  # OpenAI schema allows at most 4 stop strings
+        extra: Dict[str, Any] = {}
+        if p.top_k is not None and int(p.top_k) > 0:
+            extra["top_k"] = int(p.top_k)
+        if p.repetition_penalty is not None and float(p.repetition_penalty) != 1.0:
+            extra["repetition_penalty"] = float(p.repetition_penalty)
+        if self.provider:
+            extra["provider"] = self.provider
+        if extra:
+            kw["extra_body"] = extra
+
+        last_err: Optional[Exception] = None
+        for attempt in range(6):
+            try:
+                resp = self.client.chat.completions.create(**kw)
+                text = resp.choices[0].message.content or ""
+                self._log_call(resp, kw, attempt)
+                return text.strip()
+            except (RateLimitError, APIError) as e:
+                last_err = e
+                time.sleep(min(2 ** attempt + random.random(), 20.0))
+        raise RuntimeError("judge call failed after retries: %s" % last_err)
+
+    def _log_call(self, resp: Any, kw: Dict[str, Any], attempt: int) -> None:
+        if not self._call_log:
+            return
+        try:
+            ch = resp.choices[0]
+            usage = getattr(resp, "usage", None)
+            rec = {
+                "ts": time.time(), "model": kw.get("model"), "served_model": getattr(resp, "model", None),
+                "provider": getattr(resp, "provider", None) or (getattr(resp, "model_extra", None) or {}).get("provider"),
+                "attempt": attempt, "finish_reason": getattr(ch, "finish_reason", None),
+                "prompt_tokens": getattr(usage, "prompt_tokens", None) if usage is not None else None,
+                "completion_tokens": getattr(usage, "completion_tokens", None) if usage is not None else None,
+                "max_tokens": kw.get("max_tokens"), "temperature": kw.get("temperature"),
+            }
+            with open(self._call_log, "a", encoding="utf-8") as f:
+                f.write(json.dumps(rec) + "\n")
+        except Exception:
+            pass
+
+    def describe_params(self) -> Dict[str, Any]:
+        d = self._defaults
+        return {
+            "model_name": self.model_name, "model_path": self.model_path, "backend": "openai-compat",
+            "base_url": self.base_url, "provider_pin": self.provider, "dtype": "n/a",
+            "temperature": d["temperature"], "top_p": d["top_p"], "top_k": d["top_k"],
+            "max_new_tokens": d["max_new_tokens"], "repetition_penalty": d["repetition_penalty"], "stop": d["stop"],
+            "tensor_parallel_size": None, "gpu_memory_utilization": None, "max_model_len": None,
+        }
+
+
+def build_judge(model_path: str):
+    """http(s):// spec -> OpenAICompatJudge; otherwise the original local vLLM wrappers (lazy import)."""
+    if model_path.startswith(("http://", "https://")):
+        return OpenAICompatJudge(model_path)
+    base = os.path.basename(model_path.rstrip("/")).lower()
+    if "qwen2.5-coder-32b-instruct" in base or ("qwen2.5" in base and "coder" in base):
+        from .qwen25_coder_32b import Qwen25Coder32B
+        return Qwen25Coder32B(model_path)
+    from .llama33_70b import Llama33_70B
+    return Llama33_70B(model_path)
+
+
+def judge_display_name(model_path: str) -> str:
+    if model_path.startswith(("http://", "https://")) and "#" in model_path:
+        return model_path.rsplit("#", 1)[1]
+    return os.path.basename(model_path.rstrip("/")).lower() or "local-model"
